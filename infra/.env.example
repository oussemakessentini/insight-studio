# Copy to infra/.env (git-ignored) and choose your own password:
#   copy .env.example .env
# Docker Compose reads this file for the PostgreSQL container, and the API
# imports it on startup, so the password only needs to live here.
POSTGRES_DB=insight_studio
POSTGRES_USER=insight
POSTGRES_PASSWORD=change-me-to-a-local-password

# Cube semantic layer (optional: docker compose --profile analytics up -d).
# The API signs Cube tokens with this secret and Cube verifies them; both read it from here.
# At least 32 characters (Cube refuses every request otherwise); use a random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CUBEJS_API_SECRET=change-me-to-a-long-random-secret
# Where the API reaches Cube. Leave unset to keep /api/analytics/** off (503).
# INSIGHT_CUBE_URL=http://localhost:4000
# Time zones pre-aggregations are built for, comma-separated: list the time zone of EVERY
# business (businesses.time_zone). A zone not listed is built on its first report, which can
# take longer than REPORTS_CUBE_TIMEOUT and answer 503 (Retry-After 30) until it is ready.
CUBEJS_SCHEDULED_REFRESH_TIMEZONES=America/New_York

# Which engine computes the monthly and category reports (docs/cube-reports.md):
#   sql  - PostgreSQL queries in the API (default; needs nothing else)
#   cube - Cube (needs INSIGHT_CUBE_URL and the analytics profile running). Figures are checked
#          against the latest data change; Cube problems answer 503, never stale numbers.
# REPORTS_ENGINE=cube
# Longest a report waits for Cube (all its queries together) before answering 503.
# REPORTS_CUBE_TIMEOUT=PT10S
# Longest a custom chart's SQL query may run (charts with engine "sql") before answering 503.
# Charts with engine "cube" use REPORTS_CUBE_TIMEOUT. After updating the Cube model (e.g. the
# order_products cube used by charts), restart Cube: docker compose --profile analytics restart cube
# CHARTS_STATEMENT_TIMEOUT=PT10S
# Chart runs (dashboard widgets, chart pages, previews) in progress at once per business on one API
# instance; more answer 429 with Retry-After: 1 and the web app retries. Per instance, in memory.
# CHARTS_MAX_CONCURRENT_RUNS_PER_BUSINESS=6

# Deleting a business queues a Cube purge (docs/data-retention.md): the API rebuilds every rollup in
# the zones above, the deleted business's zone and every remaining business's zone, then after this
# delay forces one more rebuild so Cube drops the superseded tables. Must exceed Cube's
# CUBEJS_TOUCH_PRE_AGG_TIMEOUT (3600 s in compose.yaml) and CUBEJS_DB_QUERY_TIMEOUT (10 min).
# CUBE_PURGE_SWEEP_DELAY=PT70M
# Cleanup is eventual: a failed purge is retried until it succeeds, after 5 minutes doubling up to
# 1 hour (insight.cube-purge.retry-delay / max-retry-delay), and survives restarts.
# Retention (days): audit events, used or expired reset/verification tokens, closed invitations.
# RETENTION_AUDIT_DAYS=400
# RETENTION_TOKEN_DAYS=7
# RETENTION_INVITATION_DAYS=400

# Subscription billing (docs/billing-api.md, docs/billing-contract.md). Provider: fake (default outside
# the prod profile: a local test checkout, no real payments), stripe (TEST MODE ONLY: live keys and
# livemode events are refused) or none (billing off; every business on Free).
# BILLING_PROVIDER=fake
# Stripe test mode (see "Stripe test-mode setup" in docs/billing-api.md). Never commit real keys.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_API_VERSION=2025-03-31.basil
# BILLING_PRO_PRICE_ID=price_...
# Shown as is on the Billing page (defaults shown below).
# BILLING_PRO_PRICE_DISPLAY=$29 / month
# BILLING_FREE_NAME=Free
# BILLING_FREE_PRICE_DISPLAY=Free
# BILLING_PRO_NAME=Pro
# Plan limits (members include open invitations; imports count completed imports per calendar month).
# BILLING_FREE_MAX_MEMBERS=3
# BILLING_FREE_MAX_STORES=2
# BILLING_FREE_MAX_CHARTS=10
# BILLING_FREE_MAX_DASHBOARDS=3
# BILLING_FREE_MAX_IMPORTS_PER_MONTH=10
# BILLING_PRO_MAX_MEMBERS=25
# BILLING_PRO_MAX_STORES=50
# BILLING_PRO_MAX_CHARTS=200
# BILLING_PRO_MAX_DASHBOARDS=50
# BILLING_PRO_MAX_IMPORTS_PER_MONTH=500
# Webhook and cancellation workers poll interval; finished billing rows kept this many days.
# BILLING_WORKER_POLL_INTERVAL=PT2S
# RETENTION_BILLING_DAYS=30
