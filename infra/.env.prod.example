# Production settings for infra/compose.prod.yaml (docs/deployment.md). Copy to infra/.env.prod (git-ignored),
# fill in real values, keep it readable by the deploy user only (chmod 600). Never commit real secrets.

# Images built by CI or `scripts/build-images.sh` (tag = git commit).
API_IMAGE=insight-api:CHANGE_ME_GIT_SHA
WEB_IMAGE=insight-web:CHANGE_ME_GIT_SHA
CUBE_IMAGE=insight-cube:CHANGE_ME_GIT_SHA

# PostgreSQL (internal to the compose network; never published).
POSTGRES_DB=insight_studio
POSTGRES_USER=insight
# A long random value: openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME

# The public https:// address users reach (behind your TLS proxy).
WEB_BASE_URL=https://insight.example.com
# Where the web container listens for your TLS proxy (host:port).
WEB_PUBLISH=127.0.0.1:8090
# The web container's address in the compose network (forwarded headers are trusted only from it).
TRUSTED_PROXIES=172.30.240.10

# A real SMTP server (submission with STARTTLS).
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM=Insight Studio <no-reply@example.com>

# Reports stay on SQL (the default). Cube is a release check that has not passed yet (docs/release-checks.md).
REPORTS_ENGINE=sql
# Only with --profile analytics:
# INSIGHT_CUBE_URL=http://cube:4000
# CUBEJS_API_SECRET=CHANGE_ME_at_least_32_random_characters
# CUBEJS_SCHEDULED_REFRESH_TIMEZONES=America/New_York

# Billing stays off until the Stripe test-mode release check passes (docs/release-checks.md).
BILLING_PROVIDER=none
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# BILLING_PRO_PRICE_ID=price_...

LOG_FORMAT=ecs
API_MEMORY=1536m
API_CPUS=2
